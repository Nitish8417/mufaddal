{% doc %}
  Outputs Organization, BreadcrumbList, and page-specific JSON-LD for Mufaddal Jewellers.
{% enddoc %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "JewelryStore",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "description": {{ shop.description | default: shop.name | json }},
    "logo": {% if settings.logo %}{{ settings.logo | image_url: width: 600 | json }}{% else %}{{ shop.url | json }}{% endif %},
    "image": {% if settings.logo %}{{ settings.logo | image_url: width: 1200 | json }}{% else %}null{% endif %},
    "priceRange": "$$$$",
    "currenciesAccepted": {{ localization.country.currency.iso_code | json }},
    "paymentAccepted": "Credit Card, Debit Card, Apple Pay, Google Pay"
  }
</script>

{%- comment -%}
  Product and article JSON-LD already render from their section templates
  (product-information / main-blog-post). Do not output bare structured_data
  here — without a script wrapper it prints as visible page text.
{%- endcomment -%}

{%- if template.name == 'collection' and collection -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | truncate: 300 | json }},
      "url": {{ canonical_url | json }}
    }
  </script>
{%- endif -%}

{%- if template.name == 'index' or template.name == 'product' or template.name == 'collection' or template.name == 'page' or template.name == 'blog' or template.name == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if template.name == 'collection' and collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif template.name == 'product' and product -%}
          {%- if collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ collection.url | json }}
            }
            ,{
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ canonical_url | json }}
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ canonical_url | json }}
            }
          {%- endif -%}
        {%- elsif template.name == 'page' and page -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif template.name == 'article' and article -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ blog.url | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ canonical_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
