<section
  class="mj-section mj-testimonials"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
>
  <div class="mj-section__inner">
    <div class="mj-section__header mj-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mj-heading" style="font-size: clamp(2rem, 4vw, 3.25rem);">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="mj-testimonials__grid">
      {%- for block in section.blocks -%}
        <article class="mj-testimonials__card mj-reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="mj-testimonials__stars" aria-label="{{ 'accessibility.rating' | t: rating: block.settings.rating }}">
              {%- for i in (1..5) -%}
                <span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <blockquote class="mj-testimonials__quote">“{{ block.settings.quote }}”</blockquote>
          {%- endif -%}
          <div class="mj-testimonials__author">
            {%- if block.settings.image != blank -%}
              <div class="mj-testimonials__photo">
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag: widths: '80, 120, 160', sizes: '64px', loading: 'lazy', alt: block.settings.name
                }}
              </div>
            {%- endif -%}
            <div>
              <p class="mj-testimonials__name">{{ block.settings.name }}</p>
              {%- if block.settings.source != blank -%}
                <p class="mj-testimonials__source">{{ block.settings.source }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- if block.settings.video_url != blank -%}
            <a class="mj-link mj-testimonials__video" href="{{ block.settings.video_url }}" target="_blank" rel="noopener">
              {{ 'mufaddal.actions.watch_review' | t }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mj-testimonials__grid {
    display: grid;
    gap: 2rem 0;
  }

  .mj-testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    padding: 0 0 2rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--mj-border);
  }

  .mj-testimonials__stars {
    color: #e6dcc6;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
  }

  .mj-testimonials__stars .is-on {
    color: var(--mj-gold);
  }

  .mj-testimonials__quote {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .mj-testimonials__author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: auto;
  }

  .mj-testimonials__photo {
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border-radius: 50%;
  }

  .mj-testimonials__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mj-testimonials__name {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mj-testimonials__source {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--mj-text) 55%, transparent);
  }

  @media (min-width: 750px) {
    .mj-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 2.5rem;
    }

    .mj-testimonials__card {
      padding: 0.5rem 0 2.25rem;
    }
  }

  @media (min-width: 1100px) {
    .mj-testimonials__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 2.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Testimonials",
  "tag": "section",
  "class": "shopify-section-luxury-testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by discerning clients worldwide"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The craftsmanship is exquisite. Our engagement ring feels timeless and deeply personal."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aisha R."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "default": "Google Review"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video review URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Testimonials",
      "category": "Mufaddal Luxury",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The craftsmanship is exquisite. Our engagement ring feels timeless and deeply personal.",
            "name": "Aisha R.",
            "source": "Google Review"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "A private consultation experience that matches the world's finest maisons.",
            "name": "Daniel K.",
            "source": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Every detail — from diamonds to packaging — felt considered and luxurious.",
            "name": "Meera S.",
            "source": "Bridal Client"
          }
        }
      ]
    }
  ]
}
{% endschema %}
