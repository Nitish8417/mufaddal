{%- liquid
  assign hero_type = section.settings.hero_type
  assign show_scroll = section.settings.show_scroll_indicator
-%}

<section
  id="LuxuryHero-{{ section.id }}"
  class="mj-hero mj-hero--{{ hero_type }} mj-hero--height-{{ section.settings.height }}"
  data-mj-hero-slider
  data-interval="{{ section.settings.slide_interval | times: 1000 }}"
  style="
    --mj-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --mj-hero-align: {{ section.settings.content_alignment }};
  "
>
  {%- if hero_type == 'slider' -%}
    <div class="mj-hero__slides">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div
            class="mj-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-mj-slide
            {{ block.shopify_attributes }}
          >
            <div class="mj-hero__media">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'mj-hero__video'
                }}
              {%- elsif block.settings.image != blank -%}
                {%- if forloop.first -%}
                  {{
                    block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      widths: '750, 1100, 1500, 1800, 2100, 2400',
                      sizes: '100vw',
                      class: 'mj-hero__image',
                      loading: 'eager',
                      fetchpriority: 'high',
                      alt: block.settings.heading
                  }}
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      widths: '750, 1100, 1500, 1800, 2100, 2400',
                      sizes: '100vw',
                      class: 'mj-hero__image',
                      loading: 'lazy',
                      alt: block.settings.heading
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'mj-hero__placeholder' }}
              {%- endif -%}
            </div>
            <div class="mj-hero__overlay"></div>
            <div class="mj-hero__content mj-reveal">
              {%- if block.settings.eyebrow != blank -%}
                <p class="mj-eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h1 class="mj-heading mj-hero__heading">{{ block.settings.heading }}</h1>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="mj-subcopy mj-hero__text">{{ block.settings.text }}</p>
              {%- endif -%}
              <div class="mj-hero__actions">
                {%- if block.settings.button_label_1 != blank -%}
                  <a class="mj-btn mj-btn--gold" href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}">
                    {{- block.settings.button_label_1 -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a class="mj-btn mj-btn--ghost" href="{{ block.settings.button_link_2 | default: '#' }}">
                    {{- block.settings.button_label_2 -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_3 != blank -%}
                  <a class="mj-btn mj-btn--ghost" href="{{ block.settings.button_link_3 | default: '#' }}">
                    {{- block.settings.button_label_3 -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="mj-hero__nav">
        <button type="button" class="mj-hero__nav-btn" data-mj-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
          ‹
        </button>
        <button type="button" class="mj-hero__nav-btn" data-mj-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
          ›
        </button>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="mj-hero__slide is-active">
      <div class="mj-hero__media">
        {%- if hero_type == 'video' and section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'mj-hero__video'
          }}
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 1800, 2100, 2400',
              sizes: '100vw',
              class: 'mj-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'mj-hero__placeholder' }}
        {%- endif -%}
      </div>
      <div class="mj-hero__overlay"></div>
      <div class="mj-hero__content mj-reveal is-visible">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="mj-heading mj-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="mj-subcopy mj-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="mj-hero__actions">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="mj-btn mj-btn--gold" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label_1 -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="mj-btn mj-btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">
              {{- section.settings.button_label_2 -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_3 != blank -%}
            <a class="mj-btn mj-btn--ghost" href="{{ section.settings.button_link_3 | default: '#' }}">
              {{- section.settings.button_label_3 -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if show_scroll -%}
    <a class="mj-hero__scroll" href="#MainContent" aria-label="{{ 'accessibility.skip_to_text' | t }}">
      <span></span>
    </a>
  {%- endif -%}
</section>

{% stylesheet %}
  .mj-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #111;
  }

  .mj-hero--height-full {
    min-height: 100svh;
  }

  .mj-hero--height-large {
    min-height: 85svh;
  }

  .mj-hero--height-medium {
    min-height: 70svh;
  }

  .mj-hero__slides,
  .mj-hero__slide {
    min-height: inherit;
  }

  .mj-hero__slide {
    position: relative;
    display: none;
    min-height: inherit;
  }

  .mj-hero__slide.is-active {
    display: grid;
  }

  .mj-hero__media,
  .mj-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .mj-hero__media img,
  .mj-hero__media video,
  .mj-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mj-hero__overlay {
    background: linear-gradient(
      to top,
      rgba(17, 17, 17, calc(0.55 + var(--mj-hero-overlay))) 0%,
      rgba(17, 17, 17, calc(0.2 + var(--mj-hero-overlay) * 0.4)) 45%,
      rgba(17, 17, 17, calc(var(--mj-hero-overlay) * 0.35)) 100%
    );
  }

  .mj-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: var(--mj-hero-align);
    text-align: var(--mj-hero-align);
    width: min(100% - 2.5rem, 72rem);
    margin: 0 auto;
    padding: calc(var(--header-group-height, 6rem) + 3rem) 0 5.5rem;
    min-height: inherit;
  }

  .mj-hero__heading {
    max-width: 14ch;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    color: #fff;
  }

  .mj-hero__text {
    color: rgba(255, 255, 255, 0.82);
  }

  .mj-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    justify-content: var(--mj-hero-align);
  }

  .mj-hero__nav {
    position: absolute;
    right: 1.25rem;
    bottom: 1.5rem;
    z-index: 3;
    display: flex;
    gap: 0.5rem;
  }

  .mj-hero__nav-btn {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(17, 17, 17, 0.25);
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .mj-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    z-index: 3;
    width: 1.25rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    transform: translateX(-50%);
  }

  .mj-hero__scroll span {
    position: absolute;
    left: 50%;
    top: 0.35rem;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: #c9a227;
    transform: translateX(-50%);
    animation: mj-scroll-dot 1.8s ease-in-out infinite;
  }

  @keyframes mj-scroll-dot {
    0% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 0.9rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mj-hero__scroll span {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Hero",
  "tag": "section",
  "class": "shopify-section-luxury-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "hero_type",
      "label": "Hero type",
      "options": [
        { "value": "image", "label": "Static image" },
        { "value": "video", "label": "Video" },
        { "value": "slider", "label": "Image / video slider" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay intensity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.hero_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mufaddal Jewellers",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless jewellery, crafted for forever",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Fine diamonds and hallmarked gold, composed with quiet luxury for life's most meaningful moments.",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop Collection",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Book Consultation",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "button_label_3",
      "label": "Tertiary button label",
      "default": "Explore Bridal",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "url",
      "id": "button_link_3",
      "label": "Tertiary button link",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Slider interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.hero_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Mufaddal Jewellers"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Exceptional pieces for extraordinary lives"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Supporting text",
          "default": "Discover rings, necklaces, and bridal collections designed with enduring elegance."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary button label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label",
          "default": "Book Consultation"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        },
        {
          "type": "text",
          "id": "button_label_3",
          "label": "Tertiary button label",
          "default": "Explore Bridal"
        },
        {
          "type": "url",
          "id": "button_link_3",
          "label": "Tertiary button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero",
      "category": "Mufaddal Luxury"
    }
  ]
}
{% endschema %}
