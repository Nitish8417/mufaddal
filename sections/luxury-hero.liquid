{%- liquid
  assign hero_type = section.settings.hero_type
  assign show_scroll = section.settings.show_scroll_indicator
  assign align = section.settings.content_alignment
  case align
    when 'center'
      assign text_align = 'center'
      assign justify = 'center'
    when 'flex-end'
      assign text_align = 'right'
      assign justify = 'flex-end'
    else
      assign text_align = 'left'
      assign justify = 'flex-start'
  endcase

  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign slide_count = slide_blocks.size
-%}

<section
  id="LuxuryHero-{{ section.id }}"
  class="mj-hero mj-hero--{{ hero_type }} mj-hero--height-{{ section.settings.height }}{% if hero_type == 'slider' and slide_count > 1 %} mj-hero--has-slider{% endif %}"
  {% if hero_type == 'slider' and slide_count > 1 %}
    data-mj-hero-slider
    data-interval="{{ section.settings.slide_interval | times: 1000 }}"
  {% endif %}
  style="
    --mj-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --mj-hero-align: {{ justify }};
    --mj-hero-text-align: {{ text_align }};
  "
  aria-roledescription="{% if hero_type == 'slider' and slide_count > 1 %}carousel{% else %}banner{% endif %}"
  aria-label="{{ section.settings.heading | default: shop.name | escape }}"
>
  {%- if hero_type == 'slider' -%}
    <div class="mj-hero__slides" data-mj-slides>
      {%- for block in slide_blocks -%}
        <article
          class="mj-hero__slide{% if forloop.first %} is-active{% endif %}"
          data-mj-slide
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="mj-hero__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'metadata',
                  class: 'mj-hero__video'
              }}
            {%- elsif block.settings.image != blank -%}
              {%- liquid
                assign slide_alt = block.settings.heading | default: shop.name
              -%}
              {%- if forloop.first -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '750, 1100, 1500, 1800, 2100, 2400',
                    sizes: '100vw',
                    class: 'mj-hero__image',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: slide_alt
                }}
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '750, 1100, 1500, 1800, 2100, 2400',
                    sizes: '100vw',
                    class: 'mj-hero__image',
                    loading: 'lazy',
                    alt: slide_alt
                }}
              {%- endif -%}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mj-hero__placeholder' }}
            {%- endif -%}
          </div>
          <div class="mj-hero__overlay" aria-hidden="true"></div>
          <div class="mj-hero__content{% if forloop.first %} is-visible{% endif %}" data-mj-slide-content>
            {%- assign brand_label = block.settings.eyebrow | default: shop.name -%}
            {%- if brand_label != blank -%}
              <p class="mj-hero__brand">{{ brand_label }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first -%}
                <h1 class="mj-hero__heading">{{ block.settings.heading }}</h1>
              {%- else -%}
                <h2 class="mj-hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mj-hero__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
              <div class="mj-hero__actions">
                {%- if block.settings.button_label_1 != blank -%}
                  <a class="mj-btn mj-btn--gold" href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}">
                    {{- block.settings.button_label_1 -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a class="mj-btn mj-btn--ghost" href="{{ block.settings.button_link_2 | default: '#' }}">
                    {{- block.settings.button_label_2 -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if slide_count > 1 -%}
      <button type="button" class="mj-hero__nav-btn mj-hero__nav-btn--prev" data-mj-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="mj-hero__nav-btn mj-hero__nav-btn--next" data-mj-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
        <span aria-hidden="true">›</span>
      </button>
    {%- endif -%}
  {%- else -%}
    <div class="mj-hero__slide is-active mj-hero__slide--static">
      <div class="mj-hero__media">
        {%- if hero_type == 'video' and section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'mj-hero__video'
          }}
        {%- elsif section.settings.image != blank -%}
          {%- liquid
            assign hero_alt = section.settings.heading | default: shop.name
          -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 1800, 2100, 2400',
              sizes: '100vw',
              class: 'mj-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'mj-hero__placeholder' }}
        {%- endif -%}
      </div>
      <div class="mj-hero__overlay" aria-hidden="true"></div>
      <div class="mj-hero__content is-visible">
        {%- assign brand_label = section.settings.eyebrow | default: shop.name -%}
        {%- if brand_label != blank -%}
          <p class="mj-hero__brand">{{ brand_label }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="mj-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="mj-hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="mj-hero__actions">
            {%- if section.settings.button_label_1 != blank -%}
              <a class="mj-btn mj-btn--gold" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">
                {{- section.settings.button_label_1 -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a class="mj-btn mj-btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">
                {{- section.settings.button_label_2 -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if show_scroll -%}
    <button type="button" class="mj-hero__scroll" data-mj-scroll-next aria-label="{{ 'accessibility.skip_to_text' | t }}">
      <span></span>
    </button>
  {%- endif -%}
</section>

{% stylesheet %}
  .mj-hero {
    --mj-hero-pad-x: clamp(1.25rem, 4vw, 3.5rem);
    --mj-hero-pad-bottom: clamp(4.5rem, 8vh, 6.5rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    color: #fff;
    background: #111;
  }

  .mj-hero--height-full {
    min-height: 100svh;
    height: 100svh;
  }

  .mj-hero--height-large {
    min-height: 85svh;
    height: 85svh;
  }

  .mj-hero--height-medium {
    min-height: 72svh;
    height: 72svh;
  }

  .mj-hero__slides {
    position: absolute;
    inset: 0;
  }

  .mj-hero__slide {
    position: absolute;
    inset: 0;
    display: grid;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1), visibility 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mj-hero__slide--static,
  .mj-hero:not(.mj-hero--has-slider) .mj-hero__slide {
    position: relative;
    inset: auto;
    min-height: inherit;
    height: 100%;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mj-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 1;
  }

  .mj-hero__media,
  .mj-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .mj-hero__media {
    overflow: hidden;
  }

  .mj-hero__media img,
  .mj-hero__media video,
  .mj-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mj-hero__slide.is-active .mj-hero__media img,
  .mj-hero__slide.is-active .mj-hero__media video {
    transform: scale(1);
  }

  .mj-hero__overlay {
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(10, 10, 10, calc(0.42 + var(--mj-hero-overlay) * 0.25)) 0%,
        rgba(10, 10, 10, calc(0.22 + var(--mj-hero-overlay) * 0.2)) 45%,
        rgba(10, 10, 10, calc(0.58 + var(--mj-hero-overlay) * 0.3)) 100%
      );
  }

  .mj-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: var(--mj-hero-align, center);
    text-align: var(--mj-hero-text-align, center);
    box-sizing: border-box;
    width: 100%;
    max-width: 72rem;
    min-height: 100%;
    margin: 0 auto;
    padding: calc(var(--header-group-height, 6rem) + 2rem) clamp(3.5rem, 8vw, 5.5rem) var(--mj-hero-pad-bottom);
    opacity: 0;
    transform: translateY(1.1rem);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }

  .mj-hero__content > .mj-hero__brand,
  .mj-hero__content > .mj-hero__heading,
  .mj-hero__content > .mj-hero__text,
  .mj-hero__content > .mj-hero__actions {
    max-width: 40rem;
  }

  .mj-hero[style*='--mj-hero-text-align: center'] .mj-hero__content > .mj-hero__brand,
  .mj-hero[style*='--mj-hero-text-align: center'] .mj-hero__content > .mj-hero__heading,
  .mj-hero[style*='--mj-hero-text-align: center'] .mj-hero__content > .mj-hero__text,
  .mj-hero[style*='--mj-hero-text-align: center'] .mj-hero__content > .mj-hero__actions {
    margin-inline: auto;
  }

  .mj-hero[style*='--mj-hero-text-align: right'] .mj-hero__content > .mj-hero__brand,
  .mj-hero[style*='--mj-hero-text-align: right'] .mj-hero__content > .mj-hero__heading,
  .mj-hero[style*='--mj-hero-text-align: right'] .mj-hero__content > .mj-hero__text,
  .mj-hero[style*='--mj-hero-text-align: right'] .mj-hero__content > .mj-hero__actions {
    margin-inline-start: auto;
  }

  .mj-hero[style*='--mj-hero-text-align: left'] .mj-hero__content {
    justify-content: flex-end;
  }

  .mj-hero__slide.is-active .mj-hero__content,
  .mj-hero__content.is-visible {
    opacity: 1;
    transform: none;
  }

  .mj-hero__brand {
    margin: 0 0 1.15rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: lowercase;
    color: #fff;
  }

  .mj-hero__heading {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 6.4vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: #fff;
  }

  .mj-hero__text {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    font-size: clamp(0.9375rem, 1.45vw, 1.125rem);
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.8);
  }

  .mj-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
    justify-content: var(--mj-hero-align, center);
  }

  .mj-hero__nav-btn {
    position: absolute;
    top: 50%;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.32);
    background: rgba(17, 17, 17, 0.22);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transform: translateY(-50%);
    transition: border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .mj-hero__nav-btn--prev {
    left: clamp(0.75rem, 2vw, 1.5rem);
  }

  .mj-hero__nav-btn--next {
    right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .mj-hero__nav-btn:hover,
  .mj-hero__nav-btn:focus-visible {
    border-color: #c9a227;
    background: rgba(17, 17, 17, 0.5);
    color: #c9a227;
    outline: none;
  }

  .mj-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.35rem;
    z-index: 3;
    width: 1.2rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    background: transparent;
    transform: translateX(-50%);
    cursor: pointer;
  }

  .mj-hero__scroll span {
    position: absolute;
    left: 50%;
    top: 0.3rem;
    width: 0.22rem;
    height: 0.22rem;
    border-radius: 50%;
    background: #c9a227;
    transform: translateX(-50%);
    animation: mj-scroll-dot 1.8s ease-in-out infinite;
  }

  @keyframes mj-scroll-dot {
    0% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 0.85rem);
    }
  }

  @media screen and (max-width: 749px) {
    .mj-hero__nav-btn {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.35rem;
    }

    .mj-hero__nav-btn--prev {
      left: 0.65rem;
    }

    .mj-hero__nav-btn--next {
      right: 0.65rem;
    }

    .mj-hero__heading {
      font-size: clamp(2.15rem, 11vw, 3.25rem);
    }

    .mj-hero__brand {
      font-size: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mj-hero__slide,
    .mj-hero__content,
    .mj-hero__media img,
    .mj-hero__media video {
      transition: none;
    }

    .mj-hero__media img,
    .mj-hero__media video {
      transform: none;
    }

    .mj-hero__scroll span {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Hero",
  "tag": "section",
  "class": "shopify-section-luxury-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "hero_type",
      "label": "Hero type",
      "options": [
        { "value": "image", "label": "Static image" },
        { "value": "video", "label": "Video" },
        { "value": "slider", "label": "Image / video slider" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay intensity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.hero_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Brand / eyebrow",
      "default": "Mufaddal Jewellers",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Timeless jewellery, crafted for forever",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Fine diamonds and hallmarked gold, composed with quiet luxury for life's most meaningful moments.",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop Collection",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Book Consultation",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link",
      "visible_if": "{{ section.settings.hero_type != 'slider' }}"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Slider interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.hero_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Brand / eyebrow",
          "default": "Mufaddal Jewellers"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Exceptional pieces for extraordinary lives"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Supporting text",
          "default": "Discover rings, necklaces, and bridal collections designed with enduring elegance."
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary button label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label",
          "default": "Book Consultation"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero",
      "category": "Mufaddal Luxury",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
