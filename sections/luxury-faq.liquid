<section
  class="mj-section mj-faq"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
>
  <div class="mj-section__inner mj-faq__inner">
    <div class="mj-section__header mj-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mj-heading" style="font-size: clamp(1.75rem, 3vw, 2.75rem);">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="mj-faq__list mj-reveal">
      {%- for block in section.blocks -%}
        <details class="mj-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="mj-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .mj-faq__inner {
    max-width: 48rem;
  }

  .mj-faq__list {
    border-top: 1px solid var(--mj-border);
  }

  .mj-faq__item {
    border-bottom: 1px solid var(--mj-border);
  }

  .mj-faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
  }

  .mj-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .mj-faq__item summary::after {
    content: '+';
    color: var(--mj-gold);
  }

  .mj-faq__item[open] summary::after {
    content: '−';
  }

  .mj-faq__answer {
    padding: 0 0 1.2rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--mj-text) 72%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury FAQ",
  "tag": "section",
  "class": "shopify-section-luxury-faq",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guidance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you offer custom jewellery design?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Our bespoke journey includes consultation, CAD design, manufacturing, and private delivery.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury FAQ",
      "category": "Mufaddal Luxury",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer custom jewellery design?",
            "answer": "<p>Yes. Our bespoke journey includes consultation, CAD design, manufacturing, and private delivery.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Are your diamonds certified?",
            "answer": "<p>All diamonds are carefully selected and accompanied by certification details where applicable.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes. We offer insured worldwide shipping with tracked delivery on eligible orders.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
