<section
  class="mj-section mj-journey"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
>
  <div class="mj-section__inner">
    <div class="mj-section__header mj-reveal" style="text-align: {{ section.settings.heading_alignment }};">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mj-heading" style="font-size: clamp(2rem, 4vw, 3.25rem);">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="mj-subcopy" style="margin-inline: {% if section.settings.heading_alignment == 'center' %}auto{% else %}0{% endif %};">
          {{ section.settings.text }}
        </p>
      {%- endif -%}
    </div>

    <div class="mj-journey__grid">
      {%- for block in section.blocks -%}
        <article class="mj-journey__card mj-reveal" {{ block.shopify_attributes }}>
          <span class="mj-journey__number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {%- if block.settings.icon != blank -%}
            <div class="mj-journey__icon">
              {{
                block.settings.icon
                | image_url: width: 120
                | image_tag: widths: '60, 90, 120', sizes: '60px', loading: 'lazy', alt: block.settings.title
              }}
            </div>
          {%- endif -%}
          <h3 class="mj-journey__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="mj-journey__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="mj-journey__cta mj-reveal">
        <a class="mj-btn mj-btn--gold" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .mj-journey__grid {
    display: grid;
    gap: 1rem;
  }

  .mj-journey__card {
    padding: 1.75rem 1.5rem;
    background: #fff;
    border: 1px solid var(--mj-border);
    transition: border-color 0.35s ease, transform 0.35s ease;
  }

  .mj-journey__card:hover {
    border-color: var(--mj-accent);
    transform: translateY(-2px);
  }

  .mj-journey__number {
    display: block;
    margin-bottom: 1rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    color: var(--mj-gold);
  }

  .mj-journey__icon {
    width: 2.5rem;
    margin-bottom: 1rem;
  }

  .mj-journey__icon img {
    width: 100%;
    height: auto;
  }

  .mj-journey__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .mj-journey__text {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--mj-text) 70%, transparent);
  }

  .mj-journey__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (min-width: 750px) {
    .mj-journey__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 990px) {
    .mj-journey__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mj-journey__card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Jewellery Journey",
  "tag": "section",
  "class": "shopify-section-luxury-custom-journey",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bespoke"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The custom jewellery experience"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A private, guided process from first sketch to finished heirloom."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Custom Design"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Design Consultation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Share your vision in a private appointment with our design specialists."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Jewellery Journey",
      "category": "Mufaddal Luxury",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Design Consultation",
            "text": "Share your vision in a private appointment with our design specialists."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "CAD Design",
            "text": "Approve refined digital renderings before craftsmanship begins."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Manufacturing",
            "text": "Master goldsmiths bring your piece to life with hallmarked metals and certified stones."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Delivery",
            "text": "Receive your finished creation with luxury packaging and lifetime care guidance."
          }
        }
      ]
    }
  ]
}
{% endschema %}
