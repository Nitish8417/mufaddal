<section
  class="mj-section mj-craft"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
>
  <div class="mj-section__inner">
    <div class="mj-craft__layout">
      <div class="mj-craft__media mj-reveal">
        {%- if section.settings.video != blank -%}
          <div class="mj-media mj-craft__video">
            {{
              section.settings.video
              | video_tag: controls: true, muted: false, loop: false, playsinline: true, preload: 'metadata', class: 'mj-craft__video-el'
            }}
          </div>
        {%- elsif section.settings.image != blank -%}
          <div class="mj-media mj-craft__image">
            {{
              section.settings.image
              | image_url: width: 1800
              | image_tag: widths: '600, 900, 1200, 1600, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.heading
            }}
          </div>
        {%- else -%}
          <div class="mj-media mj-craft__image">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <div class="mj-craft__content mj-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mj-heading" style="font-size: clamp(2.25rem, 4vw, 3.5rem);">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="mj-subcopy mj-craft__text">{{ section.settings.text }}</div>
        {%- endif -%}

        <ol class="mj-craft__timeline">
          {%- for block in section.blocks -%}
            <li class="mj-craft__step" {{ block.shopify_attributes }}>
              <span class="mj-craft__index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <div>
                <h3 class="mj-craft__step-title">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="mj-craft__step-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>

        {%- if section.settings.button_label != blank -%}
          <a class="mj-btn mj-btn--dark" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .mj-craft__layout {
    display: grid;
    gap: 2.5rem;
  }

  .mj-craft__image,
  .mj-craft__video {
    aspect-ratio: 4 / 5;
  }

  .mj-craft__video-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mj-craft__text {
    margin-bottom: 2rem;
  }

  .mj-craft__timeline {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .mj-craft__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--mj-border);
  }

  .mj-craft__index {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    color: var(--mj-gold);
  }

  .mj-craft__step-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.35rem;
    font-weight: 400;
  }

  .mj-craft__step-text {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--mj-text) 70%, transparent);
  }

  @media (min-width: 990px) {
    .mj-craft__layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4.5rem;
      align-items: center;
    }

    .mj-craft__image,
    .mj-craft__video {
      aspect-ratio: 5 / 6;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Craftsmanship",
  "tag": "section",
  "class": "shopify-section-luxury-craftsmanship",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Craftsmanship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handcrafted with enduring mastery"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>From diamond selection to final polish, every Mufaddal piece is shaped by goldsmith expertise and an uncompromising standard of finish.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover our atelier"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Diamond selection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Only certified stones that meet our clarity, cut, and brilliance criteria are chosen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Craftsmanship",
      "category": "Mufaddal Luxury",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Design consultation",
            "text": "A private conversation to understand occasion, style, and personal meaning."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Goldsmith expertise",
            "text": "Master artisans shape hallmarked gold with quiet precision and balance."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Diamond selection",
            "text": "Certified diamonds are chosen for brilliance, proportion, and purity."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Finishing",
            "text": "Each piece is polished, inspected, and prepared for a lifetime of wear."
          }
        }
      ]
    }
  ]
}
{% endschema %}
