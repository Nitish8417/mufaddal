<section
  class="mj-section mj-trust"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
>
  <div class="mj-section__inner">
    {%- if section.settings.heading != blank -%}
      <div class="mj-section__header mj-reveal" style="text-align: center;">
        <h2 class="mj-heading" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <ul class="mj-trust__grid">
      {%- for block in section.blocks -%}
        <li class="mj-trust__item mj-reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="mj-trust__icon">
              {{
                block.settings.icon
                | image_url: width: 96
                | image_tag: widths: '48, 72, 96', sizes: '48px', loading: 'lazy', alt: block.settings.title
              }}
            </div>
          {%- else -%}
            <div class="mj-trust__mark" aria-hidden="true"></div>
          {%- endif -%}
          <h3 class="mj-trust__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="mj-trust__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .mj-trust__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .mj-trust__item {
    text-align: center;
  }

  .mj-trust__icon {
    width: 2.5rem;
    margin: 0 auto 0.85rem;
  }

  .mj-trust__icon img {
    width: 100%;
    height: auto;
  }

  .mj-trust__mark {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0 auto 0.85rem;
    border: 1px solid var(--mj-gold);
    border-radius: 50%;
    box-shadow: inset 0 0 0 4px #fff, inset 0 0 0 5px var(--mj-gold);
  }

  .mj-trust__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    font-weight: 400;
  }

  .mj-trust__text {
    margin: 0.45rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--mj-text) 65%, transparent);
  }

  @media (min-width: 990px) {
    .mj-trust__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (min-width: 1200px) {
    .mj-trust__grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Trust Badges",
  "tag": "section",
  "class": "shopify-section-luxury-trust",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Confidence in every detail"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lifetime Warranty"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Craftsmanship protected for life"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Trust Badges",
      "category": "Mufaddal Luxury",
      "blocks": [
        { "type": "badge", "settings": { "title": "Lifetime Warranty", "text": "Craftsmanship protected for life" } },
        { "type": "badge", "settings": { "title": "Certified Diamonds", "text": "Authenticated stone quality" } },
        { "type": "badge", "settings": { "title": "Hallmarked Gold", "text": "Verified metal purity" } },
        { "type": "badge", "settings": { "title": "Secure Payments", "text": "Encrypted checkout" } },
        { "type": "badge", "settings": { "title": "Worldwide Shipping", "text": "Insured global delivery" } },
        { "type": "badge", "settings": { "title": "Easy Returns", "text": "Hassle-free exchanges" } },
        { "type": "badge", "settings": { "title": "Insurance Available", "text": "Optional coverage" } }
      ]
    }
  ]
}
{% endschema %}
