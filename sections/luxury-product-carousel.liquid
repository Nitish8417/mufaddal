{%- liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.products_to_show
-%}

<section
  class="mj-section mj-carousel-section"
  style="--mj-section-bg: {{ section.settings.background }}; --mj-pad-y: {{ section.settings.padding_y }}px;"
  data-mj-carousel
>
  <div class="mj-section__inner">
    <div class="mj-section__header mj-section__header--row mj-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mj-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mj-heading" style="font-size: clamp(2rem, 4vw, 3.25rem);">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      <div class="mj-carousel__controls">
        <button type="button" class="mj-carousel__btn" data-mj-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}">‹</button>
        <button type="button" class="mj-carousel__btn" data-mj-next aria-label="{{ 'accessibility.slideshow_next' | t }}">›</button>
      </div>
    </div>

    <div class="mj-carousel__track" data-mj-track tabindex="0">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: product_limit -%}
          <article class="mj-product-card mj-reveal">
            <a class="mj-product-card__link" href="{{ product.url }}">
              <div class="mj-media mj-product-card__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 1200
                    | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 28vw, 70vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
                {%- if section.settings.show_badges -%}
                  <div class="mj-product-card__badges">
                    {%- if product.tags contains 'best-seller' or product.tags contains 'Best Seller' -%}
                      <span class="mj-badge mj-badge--gold">{{ 'mufaddal.badges.best_seller' | t }}</span>
                    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
                      <span class="mj-badge">{{ 'mufaddal.badges.new' | t }}</span>
                    {%- elsif product.tags contains 'limited' or product.tags contains 'Limited' -%}
                      <span class="mj-badge">{{ 'mufaddal.badges.limited' | t }}</span>
                    {%- elsif product.tags contains 'wedding' or product.tags contains 'Wedding' -%}
                      <span class="mj-badge">{{ 'mufaddal.badges.wedding' | t }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="mj-product-card__meta">
                <h3 class="mj-product-card__title">{{ product.title }}</h3>
                <p class="mj-product-card__price">
                  {% render 'price', product_resource: product %}
                </p>
              </div>
            </a>
            {%- if section.settings.show_quick_actions -%}
              <div class="mj-product-card__actions">
                <a class="mj-btn mj-btn--outline mj-product-card__atc" href="{{ product.url }}">
                  {{ 'mufaddal.actions.view_piece' | t }}
                </a>
                {%- if section.settings.customise_link != blank -%}
                  <a class="mj-link" href="{{ section.settings.customise_link }}">{{ 'mufaddal.actions.customise' | t }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="mj-product-card mj-reveal">
            <div class="mj-media mj-product-card__media">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="mj-product-card__meta">
              <h3 class="mj-product-card__title">{{ 'mufaddal.onboarding.product_title' | t }}</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.view_all_label != blank and collection != blank -%}
      <div class="mj-carousel__footer mj-reveal">
        <a class="mj-btn mj-btn--outline" href="{{ collection.url }}">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxury Product Carousel",
  "tag": "section",
  "class": "shopify-section-luxury-product-carousel",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges",
      "default": true,
      "info": "Uses product tags: new, limited, best-seller, wedding"
    },
    {
      "type": "checkbox",
      "id": "show_quick_actions",
      "label": "Show quick actions",
      "default": true
    },
    {
      "type": "url",
      "id": "customise_link",
      "label": "Customise link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View collection"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Luxury Product Carousel",
      "category": "Mufaddal Luxury"
    }
  ]
}
{% endschema %}
